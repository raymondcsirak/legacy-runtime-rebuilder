FROM ubuntu:18.04
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    python3 patch quilt dpkg-dev debhelper fakeroot build-essential ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && useradd -m builder
COPY . /opt/toolkit
WORKDIR /opt/toolkit
USER builder
CMD ["sh", "tests/container-check.sh"]
